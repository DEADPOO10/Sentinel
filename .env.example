# Required production secrets. Keep every value server-only.
AUTH_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
OPENAI_API_KEY=

# Optional production error tracking. The DSN is public configuration; never
# add Sentry auth tokens or source-map credentials to committed files.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ENVIRONMENT=
SENTRY_RELEASE=

# Required production configuration. AUTH_URL must be Sentinel's canonical HTTPS origin.
# DATABASE_URL must use the Neon pooled PostgreSQL endpoint.
AUTH_URL=
DATABASE_URL=

# Optional feature flags. Leave unset unless the corresponding workflow is deliberately enabled.
# Draft PR creation remains disabled unless this is exactly "true".
SENTINEL_PR_CREATION_ENABLED=
# Production validation requires a separately deployed, isolated HTTP worker.
# Set all four values in the hosting provider's production environment; never
# add the shared secret to a committed file.
SENTINEL_VALIDATION_ENABLED=
SENTINEL_VALIDATION_PROVIDER=
SENTINEL_VALIDATION_WORKER_URL=
SENTINEL_VALIDATION_WORKER_SHARED_SECRET=

# Required only when GitHub pull-request lifecycle webhooks are configured.
# Generate with: openssl rand -hex 32
SENTINEL_GITHUB_WEBHOOK_SECRET=
