# Auth.js
# Generate a value with: npx auth secret
AUTH_SECRET="replace-with-a-long-random-secret"
AUTH_URL="http://localhost:3000"

# GitHub OAuth app credentials. Never expose these values to the browser.
# Local callback: http://localhost:3000/api/auth/callback/github
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# Server-only OpenAI key for user-triggered dependency impact analysis.
OPENAI_API_KEY=""

# Server-only safety gate for explicit draft pull-request creation.
SENTINEL_PR_CREATION_ENABLED=false
